WHATSAPP_NUMBER=917010767919

# Where uploaded images (products, certifications, logo) are written.
# Leave unset for local dev (defaults to server/uploads/). In production this
# MUST point OUTSIDE the deployed code folder, since redeploys recreate it —
# e.g. on Hostinger: UPLOAD_DIR=/home/<account>/app-uploads
UPLOAD_DIR=
